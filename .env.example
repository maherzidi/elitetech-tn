# Base de donnees PostgreSQL (ex: Neon, Supabase, Vercel Postgres)
# DATABASE_URL : connexion "pooled" (utilisee par le site en production, cote serverless)
# DIRECT_URL   : connexion directe/non-poolee (utilisee uniquement pour "prisma db push"/"migrate")
# Si ton fournisseur ne donne qu'une seule chaine de connexion, mets la meme valeur pour les deux.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session admin (change ces valeurs avant la mise en prod)
ADMIN_EMAIL="admin@elitetech.tn"
ADMIN_PASSWORD="ChangeMoi123!"
AUTH_SECRET="remplace-par-une-longue-chaine-aleatoire"

